# Normalise line endings in the repository; check out native on Windows.
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets must never be normalised.
*.png   binary
*.ico   binary
*.icns  binary
*.exe   binary